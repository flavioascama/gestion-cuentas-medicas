# Copiar a .env y ajustar. Ningun valor real de credencial va en este archivo
# de ejemplo ni se versiona en .env (ver .gitignore).

# --- Backend / API ---
ENTORNO=desarrollo
NIVEL_LOG=INFO
CLAVE_FIRMA_SESION=
DURACION_SESION_MINUTOS=480

# --- Base de datos (Fase 1) ---
POSTGRES_USER=gestion_cuentas
POSTGRES_PASSWORD=
POSTGRES_DB=gestion_cuentas
POSTGRES_PORT=5432
URL_BASE_DATOS=postgresql+asyncpg://gestion_cuentas:<POSTGRES_PASSWORD>@postgres:5432/gestion_cuentas

# --- Simulador ACREDITA SALUD (Fase 10; consumido por el robot RPA de la
# Fase 11) ---
# Mismo patron que el simulador receptor IAFAS (Fase 8): vive en su propio
# arbol con su propio docker-compose (simuladores/acredita_salud/), unido
# a la misma red externa compartida red_oe1_simuladores. El backend/
# trabajador en Docker lo alcanza por el nombre de su servicio y su puerto
# INTERNO de contenedor (8000, no el publicado en el host, 8100).
ACREDITA_SALUD_URL_BASE=http://acredita-salud:8000
ACREDITA_SALUD_USUARIO=ipress_demo
ACREDITA_SALUD_CLAVE=

# --- Simulador receptor IAFAS / FTP (Fase 8) ---
# El simulador vive en su propio arbol con su propio docker-compose
# (simuladores/receptor_iafas/), no en este archivo (Regla 0.5). Ambos
# docker-compose se unen a la red externa `red_oe1_simuladores` (crearla
# una vez: `docker network create red_oe1_simuladores`; ver README.md), asi
# que el backend en Docker alcanza al simulador por el nombre de su
# servicio ("receptor-iafas") y su puerto INTERNO de contenedor (21), no el
# publicado en el host. docker-compose.yml ya fija ese valor por defecto;
# estas lineas solo hacen falta para correr el backend LOCAL, sin Docker,
# contra el simulador en Docker (usar el puerto publicado en el host,
# 2121 por defecto en simuladores/receptor_iafas/.env.ejemplo).
# FTP_RECEPTOR_IAFAS_HOST=localhost
# FTP_RECEPTOR_IAFAS_PUERTO=2121
FTP_RECEPTOR_IAFAS_USUARIO=ipress_local
FTP_RECEPTOR_IAFAS_CLAVE=
# Portal de respuestas del mismo simulador (Fase 12): puerto HTTP, no FTP.
# En Docker resuelve por defecto a http://receptor-iafas:8000 (puerto
# interno). Para el backend LOCAL sin Docker, usar el puerto publicado en
# el host (8101 por defecto en simuladores/receptor_iafas/.env.ejemplo).
# RECEPTOR_IAFAS_URL_BASE=http://localhost:8101

# --- Simulador TEDEF Web (Fase 14; consumido por el robot del validador
# de la Fase 16) ---
# Mismo patron que ACREDITA SALUD arriba: vive en su propio arbol con su
# propio docker-compose (simuladores/tedef_web/), puerto INTERNO de
# contenedor (8000, no el publicado en el host, 8102 por defecto).
TEDEF_WEB_URL_BASE=http://tedef-web:8000
TEDEF_WEB_USUARIO=validador_ipress_demo
TEDEF_WEB_CLAVE=

# --- Simulador PSE (adenda de ingesta y completitud) ---
# Emite el comprobante de pago de forma sincrona: sin sesion asistida ni
# CAPTCHA (un PSE real es una integracion API-a-API, no un portal
# navegado), asi que solo el backend lo necesita, no el trabajador. Mismo
# patron que ACREDITA SALUD arriba: vive en su propio arbol con su propio
# docker-compose (simuladores/pse/), puerto INTERNO de contenedor (8000,
# no el publicado en el host, 8103 por defecto).
PSE_URL_BASE=http://pse:8000

# --- Trabajador de automatizacion (Fase 11-12) ---
# sistema/automatizacion/, en el mismo docker-compose.yml (a diferencia de
# los simuladores, no es un arbol desacoplado por Regla 0.5: importa el
# paquete del backend como dependencia de ruta editable). Section 8.1, 8.3.
# REINICIOS_NAVEGADOR_CADA_N_TRABAJOS=20
# MAXIMO_INTENTOS_TRABAJO=5
# BACKOFF_BASE_SEGUNDOS=30
# INTERVALO_POLL_SEGUNDOS=5
# INTERVALO_RECONSULTA_MONITOREO_MINUTOS=15

# --- Sesiones asistidas y CAPTCHA (Fase 15, Seccion 8.4) ---
# Clave Fernet que cifra el storage_state de Playwright por portal, en el
# volumen sesiones_plataformas. Generar una propia con:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# El valor de ejemplo NO es secreto (esta en el repositorio): cambiar en
# cualquier entorno que no sea desarrollo local descartable.
CLAVE_CIFRADO_SESIONES=
# TIEMPO_LIMITE_CAPTCHA_SEGUNDOS=120
# INTERVALO_POLL_CAPTCHA_SEGUNDOS=2
# MAXIMO_INTENTOS_CAPTCHA=3
# DURACION_SESION_PLATAFORMA_MINUTOS=30

# --- Validacion oficial TEDEF Web (Fase 16, Seccion 8.3) ---
# Cuanto espera el robot a que el validador resuelva "Validando lote" en
# segundo plano antes de darse por vencido (no confundir con
# VALIDACION_SEGUNDO_PLANO_SEGUNDOS del simulador, que es cuanto TARDA el
# simulador en resolver).
# TIEMPO_LIMITE_VALIDACION_SEGUNDOS=60
# INTERVALO_POLL_VALIDACION_SEGUNDOS=3

# --- Almacen de eventos (RNF-18, AD-11) ---
# Clave del encadenamiento HMAC-SHA256. No se puede cambiar despues de
# registrar el primer evento sin invalidar la cadena.
CLAVE_HMAC_EVENTOS=

# --- Rol de aplicacion en PostgreSQL (C-10, RAS-11) ---
# El backend, el trabajador y el temporizador se conectan con este rol, sin
# superusuario; POSTGRES_USER solo se usa para las migraciones.
USUARIO_APLICACION_BD=gestion_cuentas_app
CLAVE_USUARIO_APLICACION_BD=

# --- Custodia de evidencias y respaldos (C-12, C-14, RNF-16, RNF-19) ---
# Clave Fernet de las evidencias del robot (distinta de CLAVE_CIFRADO_SESIONES).
CLAVE_CIFRADO_EVIDENCIAS=
# Frase de cifrado de los respaldos de la base (GnuPG, AES-256).
CLAVE_RESPALDOS=
# Clave Fernet de las columnas sensibles de la base (C-05). No se cambia
# sin volver a cifrar los datos.
CLAVE_CIFRADO_DATOS=

# --- Comunicaciones de la IAFAS (portal y correo) ---
# Buzon de la clinica en simuladores/correo (la clave es CLAVE_BUZON_CLINICA
# de ese simulador). El trabajador lo lee por IMAP; fuera de desarrollo,
# CORREO_IMAP_HOST, CORREO_IMAP_PUERTO y CORREO_IMAP_TLS=true apuntan al
# servidor real.
CORREO_USUARIO=cuentasmedicas@clinica.test
CORREO_CLAVE=
# Cada cuantos minutos se revisan el portal y el correo de la IAFAS.
# TEMPORIZADOR_INTERVALO_COMUNICACIONES_MINUTOS=15
