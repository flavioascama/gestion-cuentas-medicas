# Copiar a .env y ajustar. Ningun valor real de credencial va en este
# archivo de ejemplo ni se versiona en .env (ver .gitignore de la raiz).

TEDEF_WEB_USUARIO=validador_ipress_demo
TEDEF_WEB_CLAVE=

SESION_EXPIRACION_MINUTOS=30

# Seccion 9.2: tiempo simulado que tarda "Validando Lote" en segundo plano
# antes de que "Refrescar tabla" muestre el resultado (no son los 10
# minutos reales del manual: un simulador de pruebas deterministas no
# necesita esa espera, solo reproducir el estado intermedio).
VALIDACION_SEGUNDO_PLANO_SEGUNDOS=3

# Latencia artificial y modo de falla inducido (Seccion 9). MODO_FALLA:
# ninguno | forzar_observaciones. Tambien se puede cambiar en caliente con
# POST /admin/falla (form: modo=...).
LATENCIA_ARTIFICIAL_MS=0
MODO_FALLA=ninguno

# Fase 20: expone GET /admin/captcha(/{id}) con el texto vigente del
# CAPTCHA, para que una prueba de integracion pueda responderlo por la API
# actuando como el usuario humano, sin abrir un navegador ni usar OCR.
# Lo usan las pruebas automatizadas y la verificacion manual, actuando
# como el usuario humano -- nunca el robot de sesion asistida. Dejar en
# false salvo que se este probando a mano.
SIMULADOR_MODO_PRUEBA=false

# Puerto publicado al HOST (docker-compose.yml de este simulador), no el
# interno de contenedor (8000).
PORTAL_PUERTO_HOST=8102
