# Copiar a .env y ajustar. Ningun valor real de credencial va en este
# archivo de ejemplo ni se versiona en .env (ver .gitignore de la raiz).

ACREDITA_SALUD_USUARIO=ipress_demo
ACREDITA_SALUD_CLAVE=
ACREDITA_SALUD_PERFIL_CARGA_MASIVA=true

# Codigo RENIPRESS sintetico (8 caracteres) de la IPRESS que "opera" esta
# sesion simulada (Seccion 6.1: toda acreditacion generada queda asociada
# a este codigo).
IPRESS_CODIGO_SIMULADO=12345678

SESION_EXPIRACION_MINUTOS=30

# Latencia artificial y modo de falla inducida (Seccion 9.1). MODO_FALLA:
# ninguno | caida_servicio | expiracion_sesion | respuesta_vacia. Tambien
# se puede cambiar en caliente con POST /admin/falla (form: modo=...).
LATENCIA_ARTIFICIAL_MS=0
MODO_FALLA=ninguno

# Seccion 8.4: solo con esto en true responde GET /admin/captcha/{id} (el
# texto del CAPTCHA vigente). Lo usan las pruebas automatizadas y la
# verificacion manual, actuando como el usuario humano -- nunca el robot
# de sesion asistida. Dejar en false salvo que se este probando a mano.
SIMULADOR_MODO_PRUEBA=false

# Puerto publicado al HOST (docker-compose.yml de este simulador), no el
# interno de contenedor (8000).
PORTAL_PUERTO_HOST=8100
