# Copiar a .env y ajustar. Ningun valor real de credencial va en este
# archivo de ejemplo ni se versiona en .env (ver .gitignore de la raiz).

FTP_USUARIO=ipress_local
FTP_CLAVE=
FTP_PUERTO=21
FTP_PUERTOS_PASIVOS_DESDE=30000
FTP_PUERTOS_PASIVOS_HASTA=30009
# Solo hace falta si un cliente FTP se conecta por los puertos PUBLICADOS
# en el host (ver FTP_PUERTO_HOST/FTP_PUERTOS_PASIVOS_* en docker-compose.yml
# de este simulador), por ejemplo un backend local sin Docker. Poner aqui
# la IP por la que ese cliente alcanza a este host (127.0.0.1 si el cliente
# corre en la misma maquina). Dejar vacio para el flujo normal
# contenedor-a-contenedor (red_oe1_simuladores): ahi no hace falta, cada
# contenedor ve la IP real del otro en esa red.
FTP_DIRECCION_ENMASCARADA=

PORTAL_PUERTO=8000

# Puertos publicados al HOST (docker-compose.yml de este simulador), no los
# internos de contenedor de arriba.
PORTAL_PUERTO_HOST=8101
FTP_PUERTO_HOST=2121

# Correo de la IAFAS (simuladores/correo). Vacio SMTP_HOST: solo portal.
SMTP_HOST=correo
SMTP_PUERTO=3025
CORREO_REMITENTE=auditoria@iafas.test
CORREO_DESTINO_IPRESS=cuentasmedicas@clinica.test
